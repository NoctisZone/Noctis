	"private": true,
	"description": "Noctis Zone integration layer \u00e2\u20ac\u201d Midnight SDK wrapper, Blockfrost client, wallet connections",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
